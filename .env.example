# ---- core ----
ENVIRONMENT=local
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://copilot:copilot@localhost:5432/copilot

# ---- slack ----
# 'socket' = WebSocket, no public URL, best for local dev (needs SLACK_APP_TOKEN)
# 'http'   = Bolt ASGI adapter on FastAPI, the production path (needs SLACK_SIGNING_SECRET)
SLACK_MODE=socket
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
SLACK_SIGNING_SECRET=
SLACK_CHANNEL_ID=C...

# ---- anthropic ----
# Optional: the SDK also picks up an `ant auth login` profile.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
AGENT_INVESTIGATE_EFFORT=high
